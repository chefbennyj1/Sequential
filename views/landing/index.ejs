<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/views/shared/styles/fonts.css">
  <style>
    body {
      overflow: hidden;
      margin: 0;
      padding: 0;
    }
  </style>
  <title>Sequential Comic Studio</title>
</head>

<body>
  <div id="loading-page">
    <div id="logo-svg-container"></div>
    <div class="initializing-text-container">
      <div class="initializing-progress"></div>
      <div class="initializing-text"></div>
    </div>
    <a id="enter-btn" href="/library">[ login ]</a>
  </div>

  <script type="module">
    import { loadCSS } from '/libs/Utility.js';

    (async () => {
      await loadCSS('/views/landing/landingPage.css');
      await loadLogo();
    })();

    async function loadLogo() {
      const container = document.getElementById('logo-svg-container');
      const enterBtn = document.getElementById('enter-btn');

      const res = await fetch('/resources/logo.svg');
      const svgText = await res.text();

      const parser = new DOMParser();
      const svgDoc = parser.parseFromString(svgText, 'image/svg+xml');
      const svg = svgDoc.querySelector('svg');
      const path = svgDoc.querySelector('path');

      svg.setAttribute('id', 'loading-logo');
      svg.setAttribute('viewBox', '-10 -10 420 420');
      svg.setAttribute('width', '200');
      svg.setAttribute('height', '200');
      svg.setAttribute('overflow', 'visible');

      path.setAttribute('fill', '#fff');
      path.setAttribute('fill-opacity', '1');
      path.setAttribute('fill-rule', 'evenodd');
      path.setAttribute('stroke', '#fff');
      path.setAttribute('stroke-width', '8');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');

      container.appendChild(svg);

      const len = path.getTotalLength();
      gsap.set(path, { strokeDasharray: len, strokeDashoffset: len });

      gsap.timeline()
        .to(path, { strokeDashoffset: 0, duration: 2.4, ease: 'power2.inOut' })
        .to(path, { strokeOpacity: 0, duration: 0.5, ease: 'power1.out' }, '-=0.5')
        .fromTo(enterBtn,
          { opacity: 0, y: 20 },
          { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }
        , '-=0.2');
    }
  </script>

  <!-- GSAP core -->
  <script src="libs/gsap/gsap.min.js"></script>
  <script src="libs/gsap/ScrambleTextPlugin.min.js"></script>

</body>

</html>
