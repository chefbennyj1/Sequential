<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/views/shared/styles/fonts.css">
  <style>
    body {
      overflow: hidden;
      margin: 0;
      padding: 0;
    }
  </style>
  <title>Sequential Comic Studio</title>
</head>

<body>
  <div id="loading-page">
    <img id="loading-logo" src="/resources/logo.svg" alt="Sequential Comic Studio">
    <div class="initializing-text-container">
      <div class="initializing-progress"></div>
      <div class="initializing-text"></div>
    </div>
    <a id="enter-btn" href="/library">[ login ]</a>
  </div>

  <script type="module">
    import { loadCSS } from '/libs/Utility.js';

    (async () => {
      await loadCSS('/views/landing/landingPage.css');

      const enterBtn = document.getElementById('enter-btn');
      enterBtn.style.display = 'block';
      gsap.fromTo(enterBtn,
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 1, delay: 0.5, ease: 'power2.out' }
      );
    })();
  </script>

  <!-- GSAP core -->
  <script src="libs/gsap/gsap.min.js"></script>
  <script src="libs/gsap/ScrambleTextPlugin.min.js"></script>

</body>

</html>
