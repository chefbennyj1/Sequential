<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <% if (typeof extraStyles !== 'undefined') { %>
        <%- extraStyles %>
    <% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
    <%- include('../partials/header') %>

    <main id="main-content">
        <%- body %>
    </main>

    <script>
        window.APP_CONFIG = <%- typeof config !== 'undefined' ? JSON.stringify(config) : '{}' %>;
    </script>

    <!-- Icon Packages -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

    <!-- Socket.IO -->
    <script src="/socket.io/socket.io.js"></script>

    <script>
        // --- Global Fetch Interceptor ---
        // Intercept all fetch calls to catch 401/403 errors and redirect to login
        (function() {
            const originalFetch = window.fetch;
            window.fetch = async (...args) => {
                const response = await originalFetch(...args);
                if ((response.status === 401 || response.status === 403) && window.location.pathname !== '/login') {
                    console.warn("[Auth] Session expired or unauthorized. Redirecting to login...");
                    window.location.href = '/login';
                }
                return response;
            };
        })();
    </script>

    <!-- SortableJS -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

    <% if (typeof extraScripts !== 'undefined') { %>
        <%- extraScripts %>
    <% } %>
</body>
</html>
