<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Preview</title>
    <!-- Page-specific layout CSS -->
    <% 
       let seriesFolder = series;
    %>
    <link rel="stylesheet" href="/Library/<%= seriesFolder %>/Volumes/<%= volume %>/<%= chapter %>/<%= pageId %>/page.css">
    <% if (isSpread && partnerPage) { %>
        <link rel="stylesheet" href="/Library/<%= seriesFolder %>/Volumes/<%= volume %>/<%= chapter %>/<%= partnerPage.pageId %>/page.css">
    <% } %>
</head>
<body class="preview-mode <%= isSpread ? 'spread-view' : '' %>">
    <input type="file" id="globalPanelUpload" style="display:none" accept="image/*,video/*">

    <div id="preview-container" class="<%= isSpread ? 'flex-row' : '' %>">
        <% if (leftPage) { %>
            <div class="page-container <%= isSpread ? 'half-width' : '' %>" data-page-id="<%= leftPage.pageId %>">
                <%- leftPage.html %>
            </div>
        <% } %>
        <% if (isSpread && rightPage) { %>
            <div class="page-container half-width" data-page-id="<%= rightPage.pageId %>">
                <%- rightPage.html %>
            </div>
        <% } %>
    </div>

    <script type="module">
        import { loadCSS } from "/libs/Utility.js";
        import { init as initPreview } from "/views/dashboard/studio/preview/preview.js";

        (async () => {
            await loadCSS("/views/dashboard/studio/preview/preview.css");
            
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || 'portrait';

            const container = document.getElementById('preview-container');
            const params = {
                series: "<%= series %>",
                volume: "<%= volume %>",
                chapter: "<%= chapter %>",
                pageId: "<%= pageId %>",
                mode: mode,
                isSpread: <%= isSpread %>,
                partnerPageId: "<%= (isSpread && leftPage && rightPage) ? (pageId === leftPage.pageId ? rightPage.pageId : leftPage.pageId) : '' %>"
            };

            await initPreview(container, params);
        })();
    </script>
</body>
</html>
