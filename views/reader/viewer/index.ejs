<%- include('../../shared/layouts/main', { 
    title: 'Viewer - ' + (volume.series ? volume.series.title : 'No Overflow'), 
    bodyClass: 'viewer-page',
    headerButtons: `
        <div class="page-nav-buttons">
            <a href="/library/series/${volume.series._id}/volume/${volume._id}" class="nav-button btn">
                Chapters <ion-icon size="large" name="library"></ion-icon>
            </a>
            <button id="load-prev-btn" class="nav-button btn">
                <ion-icon size="large" name="play-back"></ion-icon> Previous Page
            </button>
            <button id="load-next-btn" class="nav-button btn">
                Next Page <ion-icon size="large" name="play-forward"></ion-icon>
            </button>
            <button id="reload-page-btn" class="nav-button btn">
                Reload page <ion-icon size="large" name="reload-circle"></ion-icon>
            </button>
            <button id="toggle-gutter-btn" class="nav-button btn">
                Gutter Guide <ion-icon size="large" name="cut-outline"></ion-icon>
            </button>
            <button id="toggle-mode-btn" class="nav-button btn">
                <span id="mode-text">Portrait</span> <ion-icon size="large" name="phone-portrait-outline"></ion-icon>
            </button>
        </div>
    `,
    body: `
        <div class="scroll-wrapper" data-volume-id="${volume._id}" data-current-page="0" data-total-pages=""></div>
        <div id="gutter-guide"></div>
        <style>
            #gutter-guide {
                position: fixed;
                top: 0;
                left: 50%;
                width: 2px;
                height: 100vh;
                background: repeating-linear-gradient(to bottom, rgba(255, 0, 0, 0.6), rgba(255, 0, 0, 0.6) 10px, transparent 10px, transparent 20px);
                z-index: 9999;
                pointer-events: none;
                display: none;
                transform: translateX(-50%);
            }
            #gutter-guide.visible {
                display: block;
            }
            #toggle-gutter-btn.active {
                background: rgba(255, 0, 0, 0.2);
                border-color: rgba(255, 0, 0, 0.5);
            }
            #toggle-mode-btn.portrait-active {
                background: var(--cyber-primary, #00ff41);
                color: #000;
            }
        </style>
    `,
    extraScripts: `
        <script type="module">
            import { initPageManager } from "/services/public/PageManager.js";
            import { getLastVisitedPage, setLastVisitedPage } from "/libs/Utility.js";
            import { fetchChapterData, syncPageData } from "/views/reader/api/ReaderClient.js";

            const params = new URLSearchParams(window.location.search);
            const exportSecret = params.get('exportSecret');

            window.GEMINI_PORTRAIT_MODE = true; // Always true now as we use spreads for landscape
            window.GEMINI_SPREAD_MODE = params.get('spread') === 'true'; // Manual toggle only

            const modeBtn = document.getElementById('toggle-mode-btn');
            const modeText = document.getElementById('mode-text');

            if (window.GEMINI_SPREAD_MODE) {
                modeBtn.classList.add('portrait-active');
                if (modeText) modeText.textContent = 'Single Page';
            } else {
                if (modeText) modeText.textContent = 'Spread View';
            }

            if (modeBtn) {
                modeBtn.addEventListener('click', () => {
                    const newUrl = new URL(window.location.href);
                    if (window.GEMINI_SPREAD_MODE) {
                        newUrl.searchParams.set('spread', 'false');
                    } else {
                        newUrl.searchParams.set('spread', 'true');
                    }
                    window.location.href = newUrl.href;
                });
            }

            (async () => {
                const scrollWrapper = document.querySelector(".scroll-wrapper");
                const volumeId = scrollWrapper.dataset.volumeId;
                let chapterNumber = params.get("chapter") || "1";

                if (!params.get("chapter")) {
                    const newUrl = new URL(window.location.href);
                    newUrl.searchParams.set("chapter", "1");
                    window.history.replaceState({ path: newUrl.href }, "", newUrl.href);
                }

                const chapter = await fetchChapterData(volumeId, chapterNumber);
                if (!chapter || !chapter.ok || !chapter.view || !chapter.view.pages || chapter.view.pages.length === 0) {
                    console.error("No chapter data found.");
                    return;
                }

                const chapterView = chapter.view;
                chapterView.pages.sort((a, b) => a.index - b.index);

                let pages;
                const spreads = [];
                
                // Group pages into spreads or single pages
                // If exportSecret is present, force every page to be single
                const isExportMode = !!exportSecret;

                for (let i = 0; i < chapterView.pages.length; i++) {
                    const page = chapterView.pages[i];
                    const spreadData = page.header?.spread || { type: 'none' };
                    const layoutId = page.layouts?.portrait || page.layouts?.landscape;
                    const isEven = page.index % 2 === 0;

                    if (isExportMode) {
                        // FORCE SINGLE PAGE MODE FOR EXPORTER
                        spreads.push([page]);
                    } else {
                        // NORMAL BROWSER BEHAVIOR
                        // CASE 1: Explicit 'left' of a spread in metadata
                        if (spreadData.type === 'left' && i < chapterView.pages.length - 1) {
                            const next = chapterView.pages[i + 1];
                            spreads.push([page, next]);
                            i++; // Skip paired page
                        } 
                        // CASE 2: Legacy Spread Layout (Self-contained wide page)
                        else if (layoutId === 'Standard_Page_Spread') {
                            spreads.push([page]);
                        }
                        // CASE 3: Manual Spread Mode Fallback (Page 1 single, 2+3, 4+5...)
                        else if (window.GEMINI_SPREAD_MODE && page.index > 1 && isEven && i < chapterView.pages.length - 1) {
                             const next = chapterView.pages[i + 1];
                             // Only pair if next page isn't explicitly a 'left' page or a legacy spread
                             const nextSpreadData = next.header?.spread || { type: 'none' };
                             const nextLayoutId = next.layouts?.portrait || next.layouts?.landscape;
                             
                             if (nextSpreadData.type !== 'left' && nextLayoutId !== 'Standard_Page_Spread') {
                                 spreads.push([page, next]);
                                 i++;
                             } else {
                                 spreads.push([page]);
                             }
                        }
                        // CASE 4: Single Page
                        else {
                            spreads.push([page]);
                        }
                    }
                }

                // Render the groups (sections)
                spreads.forEach((group, index) => {
                    const isDualSpread = group.length > 1;
                    const isLegacyWide = group.length === 1 && (group[0].layouts?.portrait === 'Standard_Page_Spread' || group[0].layouts?.landscape === 'Standard_Page_Spread');
                    
                    const section = document.createElement("section");
                    section.id = 'section-' + index;
                    section.className = 'section-' + index + ' scroll-section page-container';
                    
                    if (isDualSpread || isLegacyWide) {
                        section.classList.add('spread-mode');
                        if (isLegacyWide) section.classList.add('full-width-spread');
                    }

                    // Cover page logic
                    if (group.length === 1 && group[0].index === 1 && !isLegacyWide) {
                        section.classList.add('cover-section');
                    }

                    // MASTER CONTAINER: The section-container shouldn't change. 
                    // Every scroll unit has exactly one master stage.
                    const masterContainer = document.createElement("div");
                    masterContainer.className = "section-container master-stage";
                    masterContainer.id = 'section-' + index + '-master';
                    
                    if (isDualSpread) {
                        const spreadWrapper = document.createElement("div");
                        spreadWrapper.className = "spread-wrapper";
                        
                        group.forEach((page, pIndex) => {
                            const pageInner = document.createElement("div");
                            pageInner.id = 'section-' + index + '-p' + pIndex;
                            pageInner.className = "page-inner-container";
                            spreadWrapper.appendChild(pageInner);
                        });
                        
                        masterContainer.appendChild(spreadWrapper);
                    }

                    section.appendChild(masterContainer);
                    scrollWrapper.appendChild(section);
                });

                // Map to the internal PageManager format
                pages = spreads.map((group, index) => {
                    if (group.length > 1) {
                        return {
                            isSpread: true,
                            pages: group.map((p, pIndex) => ({
                                ...p,
                                html: p.path,
                                containerId: 'section-' + index + '-p' + pIndex
                            })),
                            containerId: 'section-' + index
                        };
                    } else {
                        return {
                            ...group[0],
                            html: group[0].path,
                            containerId: 'section-' + index + '-master'
                        };
                    }
                });

                const pageManager = initPageManager(pages);
                window.pageManager = pageManager;

                document.addEventListener("view_visible", (e) => {
                    if (!e.target.classList.contains('page-container')) return;
                    const storageKey = volumeId + "_" + chapterNumber;
                    setLastVisitedPage(storageKey, e.detail.index);
                    
                    const pageGroup = pages[e.detail.index];
                    const newUrl = new URL(window.location.href);
                    
                    if (pageGroup.isSpread) {
                        const startNum = pageGroup.pages[0].index;
                        const endNum = pageGroup.pages[pageGroup.pages.length - 1].index;
                        newUrl.searchParams.set("page", startNum + "-" + endNum);
                    } else {
                        const pathParts = pageGroup.html.split("/");
                        const pageId = pathParts[pathParts.length - 2];
                        newUrl.searchParams.set("page", pageId.replace('page', ''));
                    }
                    
                    window.history.replaceState({ path: newUrl.href }, "", newUrl.href);
                });

                document.getElementById("load-next-btn").addEventListener("click", () => {
                    const next = pageManager.currentPageIndex + 1;
                    if (next < pages.length) pageManager.goToPage(next);
                });

                document.getElementById("load-prev-btn").addEventListener("click", () => {
                    const prev = pageManager.currentPageIndex - 1;
                    if (prev >= 0) pageManager.goToPage(prev);
                });

                document.getElementById("reload-page-btn").addEventListener("click", async () => {
                    const curr = pages[pageManager.currentPageIndex];
                    if (!curr) return;
                    const parts = curr.html.split("/");
                    const pId = parts[parts.length - 2];
                    const cId = parts[parts.length - 3];
                    const res = await syncPageData(volumeId, cId, pId);
                    if (res.ok) window.location.reload();
                });

                const toggleGutterBtn = document.getElementById("toggle-gutter-btn");
                const gutterGuide = document.getElementById("gutter-guide");
                if (toggleGutterBtn && gutterGuide) {
                    toggleGutterBtn.addEventListener("click", () => {
                        const isVisible = gutterGuide.classList.toggle("visible");
                        toggleGutterBtn.classList.toggle("active", isVisible);
                    });
                }

                let initialIdx = 0;
                const pageParam = params.get("page");
                const storageKey = volumeId + "_" + chapterNumber;
                const saved = getLastVisitedPage(storageKey);
                
                let targetPageNum = pageParam ? parseInt(pageParam) : (saved !== null ? chapterView.pages[parseInt(saved)]?.index : null);

                if (targetPageNum !== null) {
                    const foundIdx = spreads.findIndex(group => group.some(p => p.index === targetPageNum));
                    if (foundIdx !== -1) initialIdx = foundIdx;
                }

                await pageManager.goToPage(initialIdx);                
                
                // --- WAIT FOR IMAGES TO LOAD (For Print Exporter) ---
                const activeSection = document.querySelector('section.active');
                if (activeSection) {
                    const imgs = Array.from(activeSection.querySelectorAll('img'));
                    await Promise.all(imgs.map(img => {
                        if (img.complete && img.naturalHeight !== 0) return Promise.resolve();
                        return new Promise(resolve => {
                            img.addEventListener('load', resolve, { once: true });
                            img.addEventListener('error', resolve, { once: true });
                            // Fallback timeout for a single image if it hangs
                            setTimeout(resolve, 15000); 
                        });
                    }));
                }

                window.renderComplete = true;
            })();

            const header = document.querySelector("header");
            let hideTimeout;
            document.addEventListener("mousemove", () => {
                if (header) header.classList.add("is-visible");
                document.body.classList.remove("cursor-hidden");
                clearTimeout(hideTimeout);
                hideTimeout = setTimeout(() => {
                    if (header) header.classList.remove("is-visible");
                    document.body.classList.add("cursor-hidden");
                }, 2000);
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "ArrowRight") document.getElementById("load-next-btn").click();
                if (e.key === "ArrowLeft") document.getElementById("load-prev-btn").click();
            });
        </script>
    `
}) %>