        </g>
      </svg>
    </div>
  </nav>
  <% if (typeof headerButtons !== 'undefined') { %>
    <div class="header-extra-buttons">
      <%- headerButtons %>
    </div>
  <% } %>
</header>

<script>
  document.addEventListener("DOMContentLoaded", async () => {
      try {
          const res = await fetch('/api/settings/global');
          
          // If the response is not OK (e.g. 401, 403), just hide the indicator or show as disabled
          if (!res.ok) {
              const svg = document.getElementById('ai-brain-svg');
              if (svg) {
                svg.style.fill = '#555';
                svg.style.filter = 'none';
              }
              return;
          }

          const data = await res.json();
          const indicator = document.getElementById('global-ai-indicator');
          const svg = document.getElementById('ai-brain-svg');
          if (data.ok && data.settings && data.settings.vision && data.settings.vision.enabled) {
              svg.style.fill = '#00ccff';
              svg.style.filter = 'drop-shadow(0 0 5px rgba(0,204,255,0.5))';
              indicator.title = 'AI Vision: Enabled';
              indicator.classList.add('ai-active');
          } else {
              svg.style.fill = '#555';
              svg.style.filter = 'none';
              indicator.title = 'AI Vision: Disabled';
              indicator.classList.remove('ai-active');
          }
      } catch (err) {
          // Silent fail for non-critical header indicator
          console.warn("AI status indicator bypassed (likely due to permissions).");
      }
  });
</script>
