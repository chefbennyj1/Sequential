<header>
  <div class="logo-wrapper">
    <div class="logo-container">
      <a href="/" class="logo-link">
        <div id="header-logo" data-text="SEQUENTIAL" class="">SEQUENTIAL</div>
      </a>
    </div>
  </div>
  <nav style="display: flex; align-items: center; gap: 15px;">
    <a href="/library" class="nav-link" title="Library"><ion-icon name="library-outline" size="large"></ion-icon></a>
    <a href="/dashboard" class="nav-link" title="Dashboard"><ion-icon name="grid-outline" size="large"></ion-icon></a>
    <div style="width: 1px; height: 24px; background: rgba(255,255,255,0.2); margin: 0 5px;"></div>
    <div id="global-ai-indicator" title="AI Status (Checking...)" style="display: flex; align-items: center; transition: all 0.3s ease;">
      <svg id="ai-brain-svg" version="1.1" width="32" height="32" viewBox="0 0 311 309" xmlns="http://www.w3.org/2000/svg" style="transition: all 0.3s ease; fill: #555;">
