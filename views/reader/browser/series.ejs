<%- include('../../shared/main', { 
    title: series.title + ' - Volumes', 
    bodyClass: 'library-page-shell',
    body: `
        <main id="main-content">
            <div class="library-root">
                <div class="library-header">
                <a href="/library" class="library-back-link">&larr; Back to Collection</a>
                <h1 id="library-logo">${series.title}</h1>
                <p class="text-muted">Select a volume to view chapters.</p>
            </div>

            <div class="library-grid">
                ${series.volumes.map(vol => `
                    <a href="/library/series/${series._id}/volume/${vol._id}" class="library-card">
                        <div class="card-shadow-wrapper">
                            <div class="card-content-container">
                                <div class="card-image-wrapper">
                                    <img src="${vol.coverImage}" alt="Volume Cover" class="cover-image">
                                </div>
                                <div class="card-overlay">
                                    <div class="card-info-top">
                                        <h2 class="series-title">Volume ${vol.index}</h2>
                                    </div>
                                    <div class="card-info-bottom">
                                        <p class="series-description">${vol.title}</p>
                                        <div class="btn read-now-btn">VIEW CHAPTERS</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                `).join('')}
            </div>
        </div>
        </main>
    `,
    extraStyles: `
        <link rel="stylesheet" href="/views/reader/browser/library.css">
    `
}) %>