<%- include('../shared/main', { 
    title: 'Login', 
    bodyClass: 'login-page-shell',
    body: `
        <main id="main-content">
            <section id="login" class="active"></section>
        </main>
    `,
    extraScripts: `
        <script type="module">
            import { loadSection } from "/services/public/PageManager.js";
            import { loadCSS, loadScript } from "/libs/Utility.js";
            import { init as initLoginPage } from "/views/auth/login.js";

            (async () => {
                await loadSection('login', '/views/auth/login.html', false);
                await loadCSS('/views/reader/ui-kit/buttons.css');
                await loadCSS('/views/auth/login.css');
                initLoginPage();
            })();
        </script>
    `
}) %>
