<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cursor Swarm Test</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #050505;
            color: #00ff41;
            font-family: 'Courier New', Courier, monospace;
            overflow: hidden;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        .ui-overlay {
            position: relative;
            z-index: 100;
            pointer-events: none;
        }
        h1 {
            font-size: 3rem;
            text-shadow: 0 0 10px #00ff41;
        }
        p {
            font-size: 1.2rem;
            opacity: 0.8;
        }
        .instruction {
            position: absolute;
            bottom: 20px;
            width: 100%;
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="ui-overlay">
        <h1>SWARM PROTOCOL</h1>
        <p>AWAITING INPUT...</p>
    </div>

    <div class="instruction">
        MOVE MOUSE TO DISRUPT | CLICK TO EXPLODE
    </div>

    <script type="module">
        import { CursorSwarm } from '/libs/CursorSwarm.js';

        document.addEventListener('DOMContentLoaded', () => {
            const swarm = new CursorSwarm({
                particleCount: 500,
                color: 0x00ff41, // Cyber Green
                particleSize: 3.0,
                orbitRadius: 40,
                followSpeed: 0.08,
                orbitSpeed: 0.04
            });

            console.log('Swarm initialized:', swarm);
        });
    </script>
</body>
</html>
